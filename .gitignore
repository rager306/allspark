
/target
/bin/
__pycache__/
steer-queue-runs/

# local gate logs (driver downloads)
clippy-*.log
fmt-*.log
tests-*.log
test-compile-*.log

# fork-local research scratch (recovered reports; never committed)
.research/

# QA deviation-suite manifests (generated per run; CI artifacts)
out/

# Transient run scratch, kept inside the repo so a system cleaner cannot delete a
# worktree's fixtures and a repo-level `rm -rf .tmp` is the whole cleanup story.
# Set by scripts/fork/prepush-gate.sh and the launcher (TMPDIR).
.tmp/

# The Verus toolchain lives beside the mirrors it proves (verus/toolchain/): one
# folder holds the specs AND the prover, so "where is the proof" has one answer.
# The binaries are 1.6 GB and are installed from the release zip, never committed.
verus/toolchain/

# cargo-verus-mutants and `cargo verus verify` build inside verus/mirrors/. That
# crate is excluded from the workspace, so these are its own artifacts; they are
# regenerated per run and never committed.
verus/mirrors/target/
verus/mirrors/Cargo.lock
