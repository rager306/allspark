{"@id": "allspark:meta/matrix_fix/F2", "@type": "allspark:Meta/matrix_fix", "id": "F2", "what": "phase_rebuild", "desc": "96 фишек без фазы; 20 нарушений порядка. Пересобрать фазы по depends_on-графу."}
{"@id": "allspark:meta/matrix_fix/F3", "@type": "allspark:Meta/matrix_fix", "id": "F3", "what": "p3_backlog", "desc": "51 фишка P3 (36%), 12 high-cost. Вынести в backlog; дедуп M6≈R17, V1≈V12/G12."}
{"@id": "allspark:meta/test_class/TC1", "@type": "allspark:Meta/test_class", "id": "TC1", "cls": "golden_parity", "src": "prime", "what": "байт-идентичность с TS при default-off", "where": "pa-*/tests/golden/", "phases": ["Ф1", "Ф4", "Ф7"]}
{"@id": "allspark:meta/test_class/TC2", "@type": "allspark:Meta/test_class", "id": "TC2", "cls": "contract_gate", "src": "daily-archive", "what": "архитектурный гейт: unsafe=forbid, слой-зависимости, FORK-ONLY", "where": "pa-*/tests/*_contract.rs", "phases": ["Ф0", "Ф1", "Ф2"]}
{"@id": "allspark:meta/test_class/TC3", "@type": "allspark:Meta/test_class", "id": "TC3", "cls": "differential", "src": "оба", "what": "closure-repair: full==incremental (proptest)", "where": "pa-graph/tests/", "phases": ["Ф3"]}
{"@id": "allspark:meta/test_class/TC4", "@type": "allspark:Meta/test_class", "id": "TC4", "cls": "shadow", "src": "daily-archive", "what": "новый путь рядом со старым (граф vs rg, LSP vs grep)", "where": "pa-graph/tests/", "phases": ["Ф1", "Ф2"]}
{"@id": "allspark:meta/test_class/TC5", "@type": "allspark:Meta/test_class", "id": "TC5", "cls": "fixtures_pos_neg", "src": "daily-archive", "what": "positive/negative пары для guards/ошибок", "where": "tests/fixtures/guards/", "phases": ["Ф4", "Ф5"]}
{"@id": "allspark:meta/test_class/TC6", "@type": "allspark:Meta/test_class", "id": "TC6", "cls": "property", "src": "prime", "what": "property-based: граф-инварианты, name_path, diff", "where": "pa-graph/pa-lsp/tests/", "phases": ["Ф0", "Ф1", "Ф2"]}
{"@id": "allspark:meta/test_class/TC7", "@type": "allspark:Meta/test_class", "id": "TC7", "cls": "e2e_lsp", "src": "prime", "what": "e2e с реальным rust-analyzer/pyright/gopls", "where": "tests/e2e/", "phases": ["Ф1", "Ф5"]}
{"@id": "allspark:meta/test_class/TC8", "@type": "allspark:Meta/test_class", "id": "TC8", "cls": "metrics_drift", "src": "daily-archive", "what": "fixture-запуск, отклонение метрик → drift_risk", "where": "checks/graph_fidelity.yaml", "phases": ["Ф2", "Ф3", "Ф6"]}
{"@id": "allspark:meta/test/T-arch", "@type": "allspark:Meta/test", "id": "T-arch", "cls": "TC2", "name": "architecture_contract", "checks": ["unsafe=forbid", "новые крейты не тянут pa-core", "FORK-ONLY маркеры"], "priority": "P0"}
{"@id": "allspark:meta/test/T-parity", "@type": "allspark:Meta/test", "id": "T-parity", "cls": "TC1", "name": "golden_parity_default_off", "checks": ["байт-идентичность upstream при выключенных флагах"], "priority": "P0"}
{"@id": "allspark:meta/test/T-lsp-e2e", "@type": "allspark:Meta/test", "id": "T-lsp-e2e", "cls": "TC7", "name": "lsp_rust_analyzer_e2e", "checks": ["definition", "references", "hover", "rename", "diagnostics"], "priority": "P0"}
{"@id": "allspark:meta/test/T-closure", "@type": "allspark:Meta/test", "id": "T-closure", "cls": "TC3", "name": "closure_repair_differential", "checks": ["full==incremental на случайных правках"], "priority": "P0"}
{"@id": "allspark:meta/test/T-guards", "@type": "allspark:Meta/test", "id": "T-guards", "cls": "TC5", "name": "guards_fixtures", "checks": ["stale_tag", "seen_lines", "noop_3x", "binding_mismatch"], "priority": "P0"}
{"@id": "allspark:meta/test/T-graph-drift", "@type": "allspark:Meta/test", "id": "T-graph-drift", "cls": "TC8", "name": "graph_fidelity_drift", "checks": ["nodes_min/max", "edge_precision", "recall_at_10"], "priority": "P1"}
{"@id": "allspark:meta/test/T-namepath", "@type": "allspark:Meta/test", "id": "T-namepath", "cls": "TC6", "name": "name_path_property", "checks": ["имена с /", "[N]", "generics", "юникод", "round-trip"], "priority": "P1"}
{"@id": "allspark:meta/test/T-shadow", "@type": "allspark:Meta/test", "id": "T-shadow", "cls": "TC4", "name": "shadow_vs_rg", "checks": ["граф vs rg на golden-запросах"], "priority": "P1"}
{"@id": "allspark:meta/test/T-cache", "@type": "allspark:Meta/test", "id": "T-cache", "cls": "TC8", "name": "cache_invalidation", "checks": ["L11 тело vs defs", "M10 граф→промах", "M11 generation drift"], "priority": "P1"}
{"@id": "allspark:meta/test/T-diag", "@type": "allspark:Meta/test", "id": "T-diag", "cls": "TC5", "name": "diagnostics_after_edit", "checks": ["snapshot до/после", "только новые", "identity-стабильность"], "priority": "P1"}
